name "r0-4b-bounded-parallel-execution"
description "R0.4b bounded parallel execution research for raster-d"
authors "Alexander Bernardi"
license "MIT"

targetType "library"
targetPath ".dub"

dflags "-preview=dip1000"

dependency "raster-d" path="../.."

